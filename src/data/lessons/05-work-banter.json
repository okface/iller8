          ],
          "notes": "'Ajde' is the casual/shortened form of 'hajde'."
        },
        {
          "id": "pauza-pet-minuta",
          "sr_latin": "Pauza pet minuta.",
          "sr_cyrillic": "Пауза пет минута.",
