          "wordRefs": [
            "pet"
          ]
        },
        {
          "id": "bez-kafe-ne-radim",
          "sr_latin": "Bez kafe ne mogu da funkcionišem.",
          "sr_cyrillic": "Без кафе не могу да функционишем.",
          "en": "I can't function without coffee.",
          "context": "A statement of fact, not a complaint. Universal among Serbian devs.",
