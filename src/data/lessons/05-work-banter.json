  "order": 5,
  "prerequisites": [],
  "phraseGroups": [
    {
      "id": "bugs-and-fixes",
      "theme": "Bugs & Fixes",
      "phrases": [
        {
          "id": "imam-bag",
          "sr_latin": "Imam bag i ne mogu da skontam odakle dolazi.",
          "sr_cyrillic": "Имам баг и не могу да сконтам одакле долази.",
          "en": "I've got a bug and I can't figure out where it's coming from.",
          "context": "Classic dev frustration — a bug you can't trace to its source.",
          "wordRefs": [
            {
              "id": "imati",
              "surface": "Imam",
              "surface_cyrillic": "Имам",
              "form": "1sg.pres"
            },
            "i",
            "ne",
            {
              "id": "moci",
              "surface": "mogu",
              "surface_cyrillic": "могу",
              "form": "1sg.pres"
            },
            "da-conj"
          ],
          "notes": "'Bag' is the Serbianized spelling of 'bug'. Tech loanwords are everywhere."
        },
        {
          "id": "radi-na-mom",
          "sr_latin": "Radi na mom računaru.",
          "sr_cyrillic": "Ради на мом рачунару.",
          "en": "It works on my machine.",
          "context": "The universal developer excuse, Serbian edition.",
          "wordRefs": [
            {
              "id": "raditi",
              "surface": "Radi",
              "surface_cyrillic": "Ради",
              "form": "3sg.pres"
            },
            "na",
            {
              "id": "moj",
              "surface": "mom",
              "surface_cyrillic": "мом",
              "case": "loc"
            }
          ],
          "notes": "'Računar' = computer. This phrase transcends all languages."
        },
        {
          "id": "ko-je-ovo-pisao",
          "sr_latin": "Ko je ovo pisao?",
          "sr_cyrillic": "Ко је ово писао?",
          "en": "Who wrote this?",
          "context": "Looking at terrible code and questioning humanity. Usually the answer is yourself, six months ago.",
          "wordRefs": [
            {
              "id": "biti",
              "surface": "je",
              "surface_cyrillic": "је",
              "form": "3sg.pres"
            }
          ],
          "variations": [
            {
              "sr_latin": "Koji je ovo haos.",
              "sr_cyrillic": "Који је ово хаос.",
              "en": "What a mess this is."
            }
          ]
        }
      ]
    },
    {
      "id": "deploy-and-releases",
      "theme": "Deploys & Releases",
      "phrases": [
        {
          "id": "pustam-deploy",
          "sr_latin": "Puštam deploy.",
          "sr_cyrillic": "Пуштам deploy.",
          "en": "I'm pushing a deploy.",
          "context": "Letting the team know you're shipping a release right now.",
          "wordRefs": [],
          "notes": "'Deploy' stays in English in most Serbian dev teams."
        },
        {
          "id": "ne-diraj-petkom",
          "sr_latin": "Ne deployuj petkom, brate.",
          "sr_cyrillic": "Не deployуј петком, брате.",
          "en": "Don't deploy on Friday, bro.",
          "context": "The sacred rule of software development, applicable in all languages.",
          "wordRefs": [
            "ne"
          ],
          "notes": "'Brate' (bro/brother) is used constantly in casual Serbian speech."
        },
        {
          "id": "pukao-prod",
          "sr_latin": "Pukao nam je prod.",
          "sr_cyrillic": "Пукао нам је прод.",
          "en": "Prod crashed on us.",
          "context": "Production is down. Panic mode activated.",
          "wordRefs": [
            {
              "id": "biti",
              "surface": "je",
              "surface_cyrillic": "је",
              "form": "3sg.pres"
            }
          ],
          "notes": "'Pukao' literally means 'burst/exploded'. Very dramatic, very Serbian."
        },
        {
          "id": "rollback",
          "sr_latin": "Moramo da rollbackujemo.",
          "sr_cyrillic": "Морамо да rollbackујемо.",
          "en": "We need to roll back.",
          "context": "When the deploy goes wrong and you need to revert.",
          "wordRefs": [
            {
              "id": "morati",
              "surface": "Moramo",
              "surface_cyrillic": "Морамо",
              "form": "1pl.pres"
            },
            "da-conj"
          ],
          "notes": "Serbian devs freely verb-ify English tech terms by adding Serbian verb endings."
        }
      ]
    },
    {
      "id": "coffee-break",
      "theme": "Coffee Break",
      "phrases": [
        {
