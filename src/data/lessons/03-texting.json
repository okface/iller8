{
  "id": "texting",
  "title": {
    "sr_latin": "Poruke i ćaskanje",
    "sr_cyrillic": "Поруке и ћаскање",
    "en": "Texting & Casual Chat"
  },
  "description": {
    "sr_latin": "Kako Srbi pišu poruke — pozdravi, planovi, skraćenice i svakodnevna komunikacija.",
    "en": "How Serbians actually text — greetings, plans, abbreviations, and everyday casual chat."
  },
  "order": 3,
  "prerequisites": [],
  "phraseGroups": [
    {
      "id": "casual-greetings",
      "theme": "Casual Greetings",
      "phrases": [
        {
          "id": "tx-cao",
          "sr_latin": "Ćao!",
          "sr_cyrillic": "Ћао!",
          "en": "Hey! / Bye!",
          "context": "You bump into a friend, or you're heading off — toss them the all-purpose casual word.",
          "wordRefs": [],
          "notes": "Serves as both hello and goodbye among friends. 'Ćao' comes from Italian 'ciao'."
        },
        {
          "id": "tx-zdravo",
          "sr_latin": "Zdravo!",
          "sr_cyrillic": "Здраво!",
          "en": "Hello! / Hi!",
          "context": "You're greeting someone you don't know that well and want a safe, friendly opener.",
          "wordRefs": [],
          "notes": "A bit more neutral than 'ćao' but still casual. Related to 'zdravlje' = health."
        },
        {
          "id": "tx-de-si",
          "sr_latin": "De si?",
          "sr_cyrillic": "Де си?",
          "en": "What's up? / Where you at?",
          "context": "You're firing off a quick hello to a close friend over text, not really asking anything.",
          "wordRefs": [
            {
              "id": "biti",
              "surface": "si",
              "surface_cyrillic": "си",
              "form": "2sg.pres"
            }
          ],
          "notes": "Clipped from 'gde si' = where are you, but it just means 'what's up'. No location answer expected."
        },
        {
          "id": "tx-gde-si",
          "sr_latin": "Gde si, brate?",
          "sr_cyrillic": "Где си, брате?",
          "en": "What's up, bro?",
          "context": "You're greeting a male buddy and want the easy, blokey tone guys use with each other.",
          "wordRefs": [
            "gde",
            {
              "id": "biti",
              "surface": "si",
              "surface_cyrillic": "си",
              "form": "2sg.pres"
            },
            {
              "id": "brat",
              "surface": "brate",
              "surface_cyrillic": "брате",
              "case": "voc"
            }
          ],
          "notes": "'Brate' = vocative of 'brat' (brother), used like 'bro' or 'dude', not literally.",
          "variations": [
            {
              "sr_latin": "Gde si, druže?",
              "sr_cyrillic": "Где си, друже?",
              "en": "What's up, buddy?",
              "gloss_hint": "another way to say it"
            }
          ]
        }
      ]
    },
    {
      "id": "opening-convo",
      "theme": "Starting a Conversation",
      "phrases": [
        {
          "id": "tx-sta-ima",
          "sr_latin": "Šta ima?",
          "sr_cyrillic": "Шта има?",
          "en": "What's up? / What's new?",
          "context": "You've said hi and want to keep it going — nudge your friend for whatever's new.",
          "wordRefs": [
            "sta",
            {
              "id": "imati",
              "surface": "ima",
              "surface_cyrillic": "има",
              "form": "3sg.pres"
            }
          ],
          "notes": "Literally 'what is there' (impersonal 'ima'). The standard follow-up to a greeting."
        },
        {
          "id": "tx-kako-si",
          "sr_latin": "Kako si?",
          "sr_cyrillic": "Како си?",
          "en": "How are you?",
          "context": "You genuinely want to know how your friend is doing, not just throw out a quick hi.",
          "wordRefs": [
            "kako",
            {
              "id": "biti",
              "surface": "si",
              "surface_cyrillic": "си",
              "form": "2sg.pres"
            }
          ],
          "notes": "More direct than 'šta ima'. Unlike in English, people often actually answer it."
        },
        {
          "id": "tx-sta-radis",
          "sr_latin": "Šta radiš?",
          "sr_cyrillic": "Шта радиш?",
          "en": "What are you up to?",
          "context": "You're texting to see if your friend is free right now, or just making conversation.",
          "wordRefs": [
            "sta",
            {
              "id": "raditi",
              "surface": "radiš",
              "surface_cyrillic": "радиш",
              "form": "2sg.pres"
            }
          ],
          "notes": "'Radiš' = present of 'raditi' (to do/work), so this asks what you're doing right now."
        },
        {
          "id": "tx-jesi-zauzet",
          "sr_latin": "Jesi zauzet?",
          "sr_cyrillic": "Јеси заузет?",
          "en": "Are you busy?",
          "context": "You want to ask a male friend something but first check he isn't tied up.",
          "wordRefs": [
            {
              "id": "biti",
              "surface": "Jesi",
              "surface_cyrillic": "Јеси",
              "form": "2sg.pres"
            },
            {
              "id": "zauzet",
              "surface": "zauzet",
              "surface_cyrillic": "заузет",
              "form": "m.sg"
            }
          ],
          "notes": "'Zauzet' = busy/occupied (masculine); 'zauzeta' for a woman. 'Jesi' is the stressed question form of 'si'.",
          "variations": [
            {
              "sr_latin": "Jesi zauzeta?",
              "sr_cyrillic": "Јеси заузета?",
              "en": "Are you busy?",
              "gloss_hint": "to a woman"
            }
          ]
        }
      ]
    },
    {
      "id": "making-plans",
      "theme": "Making Plans",
      "phrases": [
        {
          "id": "tx-ajde-na-kafu",
          "sr_latin": "Ajde na kafu?",
          "sr_cyrillic": "Ајде на кафу?",
          "en": "Wanna grab coffee?",
          "context": "You want to hang out with a friend, so you float the classic Serbian coffee invite.",
          "wordRefs": [
            {
              "id": "hajde",
              "surface": "Ajde",
              "surface_cyrillic": "Ајде"
            },
            "na",
            {
              "id": "kafa",
              "surface": "kafu",
              "surface_cyrillic": "кафу",
              "case": "acc"
            }
          ],
          "notes": "'Kafu' = accusative of 'kafa'; 'na kafu' is really 'let's hang out'. 'Kafa' is from Turkish — Bosnians say 'kahva'.",
          "variations": [
            {
              "sr_latin": "Ajde na pivo?",
              "sr_cyrillic": "Ајде на пиво?",
              "en": "Wanna grab a beer?",
              "gloss_hint": "another way to say it"
            }
          ]
        },
        {
          "id": "tx-vidimo-se",
          "sr_latin": "Vidimo se posle.",
          "sr_cyrillic": "Видимо се после.",
          "en": "See you later.",
          "context": "You're wrapping up with a friend you'll catch again the same day.",
          "wordRefs": [
            {
              "id": "videti",
              "surface": "Vidimo",
              "surface_cyrillic": "Видимо",
              "form": "1pl.pres"
            },
            "se",
            "posle"
          ],
          "notes": "'Vidimo se' = lit. 'we see each other' (reflexive 'se'). A very natural sign-off.",
          "variations": [
            {
              "sr_latin": "Vidimo se sutra.",
              "sr_cyrillic": "Видимо се сутра.",
              "en": "See you tomorrow.",
              "gloss_hint": "another way to say it"
            },
            {
              "sr_latin": "Vidimo se večeras.",
              "sr_cyrillic": "Видимо се вечерас.",
              "en": "See you tonight.",
              "gloss_hint": "another way to say it"
            }
          ]
        },
        {
          "id": "tx-gde-se-nadjemo",
          "sr_latin": "Gde da se nađemo?",
          "sr_cyrillic": "Где да се нађемо?",
          "en": "Where should we meet?",
          "context": "Plans are on and now you're sorting out the spot to meet your friend.",
          "wordRefs": [
            "gde",
            "da-conj",
            "se",
            {
              "id": "naci",
              "surface": "nađemo",
              "surface_cyrillic": "нађемо",
              "form": "1pl.pres"
            }
          ],
          "notes": "'Naći se' = to meet up / find each other; 'da se nađemo' = 'that we meet'."
        },
        {
          "id": "tx-u-koliko-sati",
          "sr_latin": "U koliko sati?",
          "sr_cyrillic": "У колико сати?",
          "en": "At what time?",
          "context": "You've agreed to meet your friend and now you need to pin down the time.",
          "wordRefs": [
            "u",
            "koliko",
            {
              "id": "sat",
              "surface": "sati",
              "surface_cyrillic": "сати",
              "case": "gen"
            }
          ],
          "notes": "'Sati' = genitive plural of 'sat' after 'koliko' (how much). Lit. 'at how many of hours'."
        }
      ]
    },
    {
      "id": "confirming-plans",
      "theme": "Confirming & Changing Plans",
      "phrases": [
        {
          "id": "tx-vazi-dogovoreno",
          "sr_latin": "Važi, dogovoreno!",
          "sr_cyrillic": "Важи, договорено!",
          "en": "Okay, it's a deal!",
          "context": "A friend proposes a time and place and you want to lock the plan in.",
          "wordRefs": [
            {
              "id": "vaziti",
              "surface": "Važi",
              "surface_cyrillic": "Важи",
              "form": "3sg.pres"
            },
            {
              "id": "dogovoriti",
              "surface": "dogovoreno",
              "surface_cyrillic": "договорено",
              "form": "ptcp.n.sg"
            }
          ],
          "notes": "'Važi' = lit. 'it holds/applies', used as 'okay'. 'Dogovoreno' = agreed, from 'dogovoriti se'."
        },
        {
          "id": "tx-kasnim",
          "sr_latin": "Kasnim malo.",
          "sr_cyrillic": "Касним мало.",
          "en": "I'm running a bit late.",
          "context": "You're on your way to meet someone but won't make it on time — give them a heads-up.",
          "wordRefs": [
            {
              "id": "kasniti",
              "surface": "Kasnim",
              "surface_cyrillic": "Касним",
              "form": "1sg.pres"
            },
            "malo"
          ],
          "notes": "'Kasnim' = 1sg of 'kasniti' (to be late); 'malo' = a little, often doing a lot of work here."
        },
        {
          "id": "tx-ne-mogu",
          "sr_latin": "Ne mogu danas, jel može sutra?",
          "sr_cyrillic": "Не могу данас, јел може сутра?",
          "en": "I can't today, is tomorrow okay?",
          "context": "Today no longer works for you, so you bail on it and float the next day instead.",
          "wordRefs": [
            "ne",
            {
              "id": "moci",
              "surface": "mogu",
              "surface_cyrillic": "могу",
              "form": "1sg.pres"
            },
            "danas",
            {
              "id": "moci",
              "surface": "može",
              "surface_cyrillic": "може",
              "form": "3sg.pres"
            },
            "sutra"
          ],
          "notes": "'Jel' is casual for 'da li je' (is it). 'Može?' = lit. 'is it possible?', i.e. 'is that okay?'."
        },
        {
          "id": "tx-otkazujem",
          "sr_latin": "Moram da otkažem, izvini.",
          "sr_cyrillic": "Морам да откажем, извини.",
          "en": "I have to cancel, sorry.",
          "context": "Something came up and you have to call off plans you'd already made with a friend.",
          "wordRefs": [
            {
              "id": "morati",
              "surface": "Moram",
              "surface_cyrillic": "Морам",
              "form": "1sg.pres"
            },
            "da-conj",
            {
              "id": "otkazati",
              "surface": "otkažem",
              "surface_cyrillic": "откажем",
              "form": "1sg.pres"
            },
            {
              "id": "izviniti",
              "surface": "izvini",
              "surface_cyrillic": "извини",
              "form": "imp.2sg"
            }
          ],
          "notes": "'Moram da' = I have to; 'otkažem' = 1sg of 'otkazati' (to cancel). 'Izvini' = sorry (imperative)."
        }
      ]
    },
    {
      "id": "checking-in",
      "theme": "Checking In On Someone",
      "phrases": [
        {
          "id": "tx-jesi-dobro",
          "sr_latin": "Jesi li dobro?",
          "sr_cyrillic": "Јеси ли добро?",
          "en": "Are you okay?",
          "context": "A friend seems off or just went through something rough and you want to check on them.",
          "wordRefs": [
            {
              "id": "biti",
              "surface": "Jesi",
              "surface_cyrillic": "Јеси",
              "form": "2sg.pres"
            },
            {
              "id": "dobar",
              "surface": "dobro",
              "surface_cyrillic": "добро",
              "form": "n.sg"
            }
          ],
          "notes": "The particle 'li' marks the yes/no question; 'dobro' = the neuter form used here for 'well'.",
          "variations": [
            {
              "sr_latin": "Jesi okej?",
              "sr_cyrillic": "Јеси океј?",
              "en": "You okay?",
              "gloss_hint": "very casual"
            }
          ]
        },
        {
          "id": "tx-sta-se-desava",
          "sr_latin": "Šta se dešava?",
          "sr_cyrillic": "Шта се дешава?",
          "en": "What's going on?",
          "context": "A friend sends something vague or cryptic and you want them to spell out what's happening.",
          "wordRefs": [
            "sta",
            "se",
            {
              "id": "desavati",
              "surface": "dešava",
              "surface_cyrillic": "дешава",
              "form": "3sg.pres"
            }
          ],
          "notes": "'Dešavati se' = to happen/occur (reflexive 'se'). Present tense — asking about right now."
        },
        {
          "id": "tx-javi-mi-se",
          "sr_latin": "Javi mi se kad stigneš.",
          "sr_cyrillic": "Јави ми се кад стигнеш.",
          "en": "Text me when you arrive.",
          "context": "A friend is travelling to you and you want to know the moment they get there safely.",
          "wordRefs": [
            {
              "id": "javiti",
              "surface": "Javi",
              "surface_cyrillic": "Јави",
              "form": "imp.2sg"
            },
            "mi-dat",
            "se",
            {
              "id": "kada",
              "surface": "kad",
              "surface_cyrillic": "кад"
            },
            {
              "id": "stici",
              "surface": "stigneš",
              "surface_cyrillic": "стигнеш",
              "form": "2sg.pres"
            }
          ],
          "notes": "'Javi se' = get in touch (imperative + reflexive); 'mi' = to me (dative clitic). 'Stigneš' = you arrive."
        },
        {
          "id": "tx-gde-si-nestao",
          "sr_latin": "Gde si nestao?",
          "sr_cyrillic": "Где си нестао?",
          "en": "Where did you disappear to?",
          "context": "A male friend has gone quiet for a while and you want to call him out, half joking.",
          "wordRefs": [
            "gde",
            {
              "id": "biti",
              "surface": "si",
              "surface_cyrillic": "си",
              "form": "2sg.pres"
            },
            {
              "id": "nestati",
              "surface": "nestao",
              "surface_cyrillic": "нестао",
              "form": "past.m.sg"
            }
          ],
          "notes": "'Nestao' = past of 'nestati' (to disappear), masculine; 'nestala' for a woman. 'Si' is the past auxiliary.",
          "variations": [
            {
              "sr_latin": "Gde si nestala?",
              "sr_cyrillic": "Где си нестала?",
              "en": "Where did you disappear to?",
              "gloss_hint": "to a woman"
            }
          ]
        }
      ]
    },
    {
      "id": "quick-responses",
      "theme": "Quick Text Responses",
      "phrases": [
        {
          "id": "tx-evo-me",
          "sr_latin": "Evo me.",
          "sr_cyrillic": "Ево ме.",
          "en": "Here I am. / I'm here.",
          "context": "A friend asks where you are or you've just walked up — let them know you've shown up.",
          "wordRefs": [
            "me-acc"
          ],
          "notes": "'Evo' = here is/here's, paired with the accusative clitic 'me' = lit. 'here me'. Extremely common."
        },
        {
          "id": "tx-nista-posebno",
          "sr_latin": "Ništa posebno.",
          "sr_cyrillic": "Ништа посебно.",
          "en": "Nothing special. / Not much.",
          "context": "A friend texts 'šta ima' and you give the default low-key answer, even if plenty is going on.",
          "wordRefs": [
            "nista"
          ],
          "notes": "'Ništa' = nothing; 'posebno' = especially/special. The classic understated Serbian reply."
        },
        {
          "id": "tx-sad-ne-mogu",
          "sr_latin": "Sad ne mogu, javim se posle.",
          "sr_cyrillic": "Сад не могу, јавим се после.",
          "en": "Can't right now, I'll text you later.",
          "context": "Someone messages while you're tied up — wave them off for now and promise to circle back.",
          "wordRefs": [
            {
              "id": "sada",
              "surface": "Sad",
              "surface_cyrillic": "Сад"
            },
            "ne",
            {
              "id": "moci",
              "surface": "mogu",
              "surface_cyrillic": "могу",
              "form": "1sg.pres"
            },
            {
              "id": "javiti",
              "surface": "javim",
              "surface_cyrillic": "јавим",
              "form": "1sg.pres"
            },
            "se",
            "posle"
          ],
          "notes": "'Javim se' = present standing in for the future; the 'ću' is dropped, as often happens in casual texting."
        },
        {
          "id": "tx-stigao-sam",
          "sr_latin": "Stigao sam.",
          "sr_cyrillic": "Стигао сам.",
          "en": "I arrived. / I'm here.",
          "context": "You've just reached the meeting spot and want to let your friend know you're there.",
          "wordRefs": [
            {
              "id": "stici",
              "surface": "stigao",
              "surface_cyrillic": "стигао",
              "form": "past.m.sg"
            },
            {
              "id": "biti",
              "surface": "sam",
              "surface_cyrillic": "сам",
              "form": "1sg.pres"
            }
          ],
          "notes": "'Stigao' = past of 'stići' (to arrive), masculine; 'stigla' for a woman. 'Sam' is the past auxiliary.",
          "variations": [
            {
              "sr_latin": "Stigla sam.",
              "sr_cyrillic": "Стигла сам.",
              "en": "I arrived.",
              "gloss_hint": "said by a woman"
            }
          ]
        }
      ]
    },
    {
      "id": "quick-check-ins",
      "theme": "Quick Check-ins",
      "phrases": [
        {
          "id": "tx-je-uspelo",
          "sr_latin": "Je l' uspelo?",
          "sr_cyrillic": "Је л' успело?",
          "en": "Did it work out?",
          "context": "A friend tried to sort something out and you want to know whether it came together.",
          "wordRefs": [
            {
              "id": "uspeti",
              "surface": "uspelo",
              "surface_cyrillic": "успело",
              "form": "past.n.sg"
            }
          ],
          "notes": "'Uspelo' = past of 'uspeti' (to succeed), neuter for an unnamed 'it'. 'Je l'' is casual for 'da li'."
        },
        {
          "id": "tx-probaj-sad",
          "sr_latin": "Probaj sad.",
          "sr_cyrillic": "Пробај сад.",
          "en": "Try it now.",
          "context": "You've just fixed or changed something for a friend and want them to give it another go.",
          "wordRefs": [
            {
              "id": "probati",
              "surface": "Probaj",
              "surface_cyrillic": "Пробај",
              "form": "imp.2sg"
            },
            {
              "id": "sada",
              "surface": "sad",
              "surface_cyrillic": "сад"
            }
          ],
          "notes": "'Probaj' = imperative of 'probati' (to try); 'sad' is the clipped, everyday form of 'sada' (now)."
        },
        {
          "id": "tx-opet-ne-radi",
          "sr_latin": "Opet ne radi.",
          "sr_cyrillic": "Опет не ради.",
          "en": "It's not working again.",
          "context": "Something you thought was sorted has broken once more and you're flagging it to a friend.",
          "wordRefs": [
            "opet",
            "ne",
            {
              "id": "raditi",
              "surface": "radi",
              "surface_cyrillic": "ради",
              "form": "3sg.pres"
            }
          ],
          "notes": "'Radi' = 3sg of 'raditi', used for things working/functioning; 'ne radi' = it doesn't work. 'Opet' = again."
        },
        {
          "id": "tx-u-guzvi-sam",
          "sr_latin": "Danas sam u gužvi.",
          "sr_cyrillic": "Данас сам у гужви.",
          "en": "I'm swamped today.",
          "context": "A friend wants your time but you're slammed and need them to know it'll have to wait.",
          "wordRefs": [
            "danas",
            {
              "id": "biti",
              "surface": "sam",
              "surface_cyrillic": "сам",
              "form": "1sg.pres"
            },
            "u",
            {
              "id": "guzva",
              "surface": "gužvi",
              "surface_cyrillic": "гужви",
              "case": "loc"
            }
          ],
          "notes": "'U gužvi' = lit. 'in a crowd/crush' (locative of 'gužva'), an idiom for being swamped or rushed off your feet."
        }
      ]
    },
    {
      "id": "text-abbreviations",
      "theme": "Serbian Text Abbreviations",
      "phrases": [
        {
          "id": "tx-nmvz",
          "sr_latin": "Nema veze (nmvz)",
          "sr_cyrillic": "Нема везе (нмвз)",
          "en": "No worries / It doesn't matter",
          "context": "A small mix-up happens over text and you want to wave it off — no big deal.",
          "wordRefs": [],
          "notes": "Texted 'nmvz' — the first letters of 'nema veze' (lit. 'no connection'). The Serbian shrug.",
          "audio_cyrillic": "Нема везе"
        },
        {
          "id": "tx-msm",
          "sr_latin": "Mislim (msm)",
          "sr_cyrillic": "Мислим (мсм)",
          "en": "I mean / I think",
          "context": "Mid-message, you want to walk back or clarify what you just said.",
          "wordRefs": [],
          "notes": "Texted 'msm', short for 'mislim' (I think / I mean). Tacked on to soften or correct.",
          "audio_cyrillic": "Мислим"
        },
        {
          "id": "tx-btj",
          "sr_latin": "Bilo to jest (btj)",
          "sr_cyrillic": "Било то јест (бтј)",
          "en": "By the way",
