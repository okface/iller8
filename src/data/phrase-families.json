      "variants": [
        {
          "id": "love-you-formal",
          "sr_latin": "Volim vas.",
          "sr_cyrillic": "Волим вас.",
          "en": "I love you.",
          "gloss_hint": "formal/plural",
          "label": "formal (vi)",
          "transform": "formality",
          "hint": "Also means 'I love you all'."
        },
        {
          "id": "love-you-past-masc",
          "sr_latin": "Voleo sam te.",
          "sr_cyrillic": "Волео сам те.",
          "en": "I loved you.",
          "gloss_hint": "masc speaker",
          "label": "past · male speaker",
          "transform": "gender-speaker",
          "note": "Past participle 'voleo' agrees with masculine 'I'."
        },
        {
          "id": "love-you-past-fem",
          "sr_latin": "Volela sam te.",
          "sr_cyrillic": "Волела сам те.",
          "en": "I loved you.",
          "gloss_hint": "fem speaker",
          "label": "past · female speaker",
          "transform": "gender-speaker"
        },
        {
          "id": "love-you-he-her",
          "sr_latin": "On je voli.",
          "sr_cyrillic": "Он је воли.",
          "en": "He loves her.",
          "label": "he loves her",
          "transform": "subject-swap",
          "hint": "'je' here is the short accusative 'her', not the verb 'is'."
        },
        {
          "id": "love-you-question",
          "sr_latin": "Voliš li me?",
          "sr_cyrillic": "Волиш ли ме?",
