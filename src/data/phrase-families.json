{
  "families": [
    {
      "id": "miss-you",
      "theme": "I miss you",
      "category": "affection",
      "lessonId": "sweet-talk",
      "base": {
        "id": "miss-you-base",
        "sr_latin": "Nedostaješ mi.",
        "sr_cyrillic": "Недостајеш ми.",
        "en": "I miss you.",
        "label": "base form",
        "transform": "subject-swap",
        "note": "Literally 'you are missing to me'. The person missed is the subject; the one feeling it is in dative (mi)."
      },
      "variants": [
        {
          "id": "miss-you-past-masc",
          "sr_latin": "Nedostajao si mi.",
          "sr_cyrillic": "Недостајао си ми.",
          "en": "I missed you.",
          "gloss_hint": "to a man",
          "label": "past · to a man",
          "transform": "tense-past",
          "note": "Past participle 'nedostajao' agrees with the masculine 'you' who was missed."
        },
        {
          "id": "miss-you-past-fem",
          "sr_latin": "Nedostajala si mi.",
          "sr_cyrillic": "Недостајала си ми.",
          "en": "I missed you.",
          "gloss_hint": "to a woman",
          "label": "past · to a woman",
          "transform": "gender-listener",
          "note": "Same idea but '-la' ending because the missed person is feminine."
        },
        {
          "id": "miss-you-formal",
          "sr_latin": "Nedostajete mi.",
          "sr_cyrillic": "Недостајете ми.",
          "en": "I miss you.",
          "gloss_hint": "formal",
          "label": "formal (vi)",
          "transform": "formality",
          "note": "Use 'vi' form with elders, bosses, strangers."
        },
        {
          "id": "miss-you-reciprocity",
          "sr_latin": "I ti meni nedostaješ.",
          "sr_cyrillic": "И ти мени недостајеш.",
          "en": "I miss you too.",
          "label": "I miss you too",
          "transform": "reciprocity",
          "hint": "Literally: and you to me are missing.",
          "note": "Word order flips for emphasis: 'i ti meni' fronts the reciprocal idea."
        },
        {
          "id": "miss-you-object-her",
          "sr_latin": "Ona mi nedostaje.",
          "sr_cyrillic": "Она ми недостаје.",
          "en": "I miss her.",
          "label": "I miss her",
          "transform": "subject-swap",
          "note": "She is the grammatical subject; the verb takes 3rd person 'nedostaje'."
        },
        {
          "id": "miss-you-object-him",
          "sr_latin": "On mi nedostaje.",
          "sr_cyrillic": "Он ми недостаје.",
          "en": "I miss him.",
          "label": "I miss him",
          "transform": "subject-swap"
        },
        {
          "id": "miss-you-intensified",
          "sr_latin": "Mnogo mi nedostaješ.",
          "sr_cyrillic": "Много ми недостајеш.",
          "en": "I miss you so much.",
          "label": "with intensifier",
          "transform": "intensifier",
          "note": "'Mnogo' is the everyday way to say 'a lot / so much'."
        },
        {
          "id": "miss-you-negation",
          "sr_latin": "Ne nedostaješ mi.",
          "sr_cyrillic": "Не недостајеш ми.",
          "en": "I don't miss you.",
          "label": "in the negative",
          "transform": "negation",
          "hint": "Cold, but grammatically clean."
        }
      ]
    },
    {
      "id": "love-you",
      "theme": "I love you",
      "category": "affection",
      "lessonId": "sweet-talk",
      "base": {
