          "label": "as a question",
          "transform": "question",
          "note": "Add 'li' after the verb for a yes/no question. Even more common: 'Da li me voliš?'"
        },
        {
          "id": "love-you-intensified",
          "sr_latin": "Mnogo te volim.",
          "sr_cyrillic": "Много те волим.",
          "en": "I love you so much.",
          "label": "with intensifier",
          "transform": "intensifier"
        },
        {
          "id": "love-you-negation",
          "sr_latin": "Ne volim te više.",
          "sr_cyrillic": "Не волим те више.",
          "en": "I don't love you anymore.",
          "label": "in the negative",
          "transform": "negation",
          "hint": "'više' = anymore / more."
        }
      ]
    },
    {
      "id": "how-are-you",
